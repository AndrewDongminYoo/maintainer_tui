{
  "name": "maintainer-tui",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "react-devtools-core": "^7.0.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cli-spinners": "^3.4.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "string-width": "8.2.0"
  },
  "version": "0.1.1",
  "bin": {
    "maintainer": "./src/cli.tsx"
  },
  "scripts": {
    "start": "bun run src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build --compile --outfile dist/maintainer src/cli.tsx",
    "dist": "bun run build && cd dist && tar -czf maintainer-darwin-arm64.tar.gz maintainer && shasum -a 256 maintainer-darwin-arm64.tar.gz"
  },
  "license": "MIT",
  "description": "A terminal dashboard over every repository you can push to",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewDongminYoo/maintainer_tui.git"
  }
}
